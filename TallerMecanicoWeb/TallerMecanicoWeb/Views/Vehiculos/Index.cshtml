@model List<TallerMecanicoWeb.Models.Vehiculo>

@{
    ViewData["Title"] = "Vehículos";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12">

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Gestión de Vehículos</h2>
        <p class="mb-0">
            Listado de vehículos registrados en Autos Varela.
        </p>
    </div>

    <a asp-controller="Vehiculos"
       asp-action="Create"
       class="btn btn-primary">
        Nuevo Vehículo
    </a>
</div>

<!-- Buscador por patente -->
<form asp-controller="Vehiculos"
      asp-action="Index"
      method="get"
      class="mb-3">

    <div class="input-group">
        <input type="text"
               name="buscar"
               value="@ViewBag.Buscar"
               class="form-control"
               placeholder="Buscar por patente..." />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>

        <a asp-controller="Vehiculos"
           asp-action="Index"
           class="btn btn-secondary">
            Limpiar
        </a>
    </div>
</form>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
        {
            <span>No se encontraron vehículos.</span>
        }
        else
        {
            <span>No hay vehículos registrados.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Patente</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Año</th>
                    <th>Color</th>
                    <th>Kilometraje</th>
                    <th>Propietario</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehiculo in Model)
                {
                    <tr>
                        <td>@vehiculo.Patente</td>
                        <td>@vehiculo.Marca</td>
                        <td>@vehiculo.Modelo</td>
                        <td>@vehiculo.Anio</td>
                        <td>@vehiculo.Color</td>
                        <td>@vehiculo.Kilometraje</td>
                        <td>
                            @if (vehiculo.Cliente != null)
                            {
                                @($"{vehiculo.Cliente.Nombre} {vehiculo.Cliente.Apellido}")
                            }
                            else
                            {
                                <span>Sin propietario</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

        </div>
    </div>
</div>
@model List<TallerMecanicoWeb.Models.Vehiculo>

@{
    ViewData["Title"] = "Vehículos";
}

<h2>Gestión de Vehículos</h2>

<p>
    <a asp-controller="Vehiculos"
       asp-action="Create"
       class="btn btn-primary">
        Nuevo Vehículo
    </a>
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No hay vehículos registrados.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Patente</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Año</th>
                <th>Color</th>
                <th>Kilometraje</th>
                <th>Propietario</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vehiculo in Model)  
            {
                <tr>
                    <td>@vehiculo.Patente</td>
                    <td>@vehiculo.Marca</td>
                    <td>@vehiculo.Modelo</td>
                    <td>@vehiculo.Anio</td>
                    <td>@vehiculo.Color</td>
                    <td>@vehiculo.Kilometraje</td>
                    <td>
                        @if (vehiculo.Cliente != null)
                        {
                            @($"{vehiculo.Cliente.Nombre} {vehiculo.Cliente.Apellido}")  
                        }
                        else
                        {
                            <span>Sin propietario</span> 
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

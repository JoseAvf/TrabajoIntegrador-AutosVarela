@model TallerMecanicoWeb.Models.Vehiculo

@{
    ViewData["Title"] = "Historial de Reparaciones";
}

<div class="container mt-4">

    <h2>Historial de Reparaciones</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                @Model.Marca @Model.Modelo
            </h5>

            <p class="mb-1">
                <strong>Patente:</strong> @Model.Patente
            </p>

            <p class="mb-1">
                <strong>Año:</strong> @Model.Anio
            </p>

            <p class="mb-0">
                <strong>Propietario:</strong>
                @if (Model.Cliente != null)
                {
                    @($"{Model.Cliente.Nombre} {Model.Cliente.Apellido}")
                }
                else
                {
                    <span>Sin propietario</span>
                }
            </p>
        </div>
    </div>

    <h4>Reparaciones registradas</h4>

    @if (Model.Reparaciones == null || !Model.Reparaciones.Any())
    {
        <div class="alert alert-info">
            Este vehículo todavía no tiene reparaciones registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Fecha de ingreso</th>
                        <th>Fecha de finalización</th>
                        <th>Descripción</th>
                        <th>Diagnóstico</th>
                        <th>Costo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reparacion in Model.Reparaciones
                        .OrderByDescending(r => r.FechaIngreso))
                    {
                        <tr>
                            <td>
                                @reparacion.FechaIngreso.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @(reparacion.FechaFinalizacion.HasValue
                                    ? reparacion.FechaFinalizacion.Value.ToString("dd/MM/yyyy")
                                    : "Pendiente")
                            </td>
                            <td>@reparacion.Descripcion</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(reparacion.Diagnostico)
                                    ? "Sin diagnóstico"
                                    : reparacion.Diagnostico)
                            </td>
                            <td>
                                @reparacion.Costo.ToString("N2")
                            </td>
                            <td>@reparacion.Estado</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Vehiculos"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Volver a Vehículos
    </a>

</div>
